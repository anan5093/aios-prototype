# ── Inference ──────────────────────────────────────────
OLLAMA_ENDPOINT=https://YOUR_NGROK_URL.ngrok.io
MODEL_NAME=gemma:2b-instruct-q4_K_M
FALLBACK_MODEL=gemma:2b-instruct-q4_K_M
LOCAL_OLLAMA=http://localhost:11434

# ── ngrok Tunnel Auth ──────────────────────────────────
NGROK_AUTH_USER=aios
NGROK_AUTH_PASS=changeme_strong_password

# ── MongoDB Atlas ──────────────────────────────────────
ATLAS_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.XXXXX.mongodb.net/
ATLAS_DB=aios_memory
ATLAS_COLLECTION=system_logs

# ── Embedding ──────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Express API ────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_min_32_chars
PORT=5000



# ── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO
